# 本地开发配置。首次启动前复制为 .env，可修改端口和密码。
# .env 不提交到 Git；本文件只提供可复现的配置示例。
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing_admin
POSTGRES_PASSWORD=local-demo-change-me
POSTGRES_PORT=15432
# 订单服务的受限数据库账号密码；独立于初始化管理员。
TICKETING_APP_PASSWORD=local-app-change-me

# FastAPI 仅监听本机；冲突时修改端口。
API_PORT=8000

# 第八阶段：数仓三类独立账号，仅 warehouse-admin init-db 时要求填写。
# 已有 .env 只追加这三项，不覆盖原有配置；日常购票服务不需要它们。
WAREHOUSE_READER_PASSWORD=local-wh-reader-change-me
WAREHOUSE_WRITER_PASSWORD=local-wh-writer-change-me
WAREHOUSE_REPORTER_PASSWORD=local-wh-reporter-change-me
